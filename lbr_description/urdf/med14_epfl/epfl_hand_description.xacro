<?xml version="1.0"?>
<robot name="epfl_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- <xacro:include filename="$(find lbr_description)/urdf/med14_epfl/common_properties.xacro" /> -->

    <!--
        The hand's measured mass and centre of mass, written by
        gepetto_control/payload_id_node. Generated, unlike the mount offset below,
        which is copied by hand. The macro retains its gepetto_ros API name so a
        regenerated payload file remains compatible with this description.
    -->
    <xacro:include filename="$(find lbr_description)/urdf/med14_epfl/epfl_payload.xacro" />

    <!--
        The epfl tendon-driven hand, as seen by the arm: a single wrist frame at the
        fixed mount offset from the flange. The hand's own morphology (fingers, tendons)
        is not modelled here - every finger origin in epfl_hand_core and every solver pose
        in crest-sparse is measured from this wrist frame, so this frame is all the arm
        side needs.

        The origin below is MountConfig.flange_from_wrist_xyz / _rpy from
        epfl_hand_core/src/epfl_hand_core/config.py, copied verbatim. No conversion is needed:
        epfl_hand_core's transform_from_xyz_rpy builds R = Rz(yaw) @ Ry(pitch) @ Rx(roll),
        which is exactly URDF's <origin rpy="roll pitch yaw"> convention.

        The z here is NOT the raw CAD number: the Onshape fit gives 0.134688 m, and
        0.139688 m is that value plus a +5 mm real-world calibration correction found on
        the physical robot. config.py carries the same corrected value; keep the two in
        step, and re-apply the correction on top of any fresh measurement rather than
        pasting the raw fit output.

        WARNING: these numbers are copied by hand and nothing here can detect a stale
        value. They were measured 2026-08-18 against the "epfl_hand / Assembly 1"
        Onshape assembly. After any change to that assembly, to the mounting bracket, or
        to the hand morphology, re-run

            python -m python.tests.tendon_hand.mount_onshape_fit

        from crest-sparse/ and copy the numbers over here AND into config.py. The rotation
        is nearly a pair of right angles, so a flipped one still looks plausible - verify
        with `ros2 run tf2_ros tf2_echo <robot_name>_link_ee <robot_name>_epfl_wrist_link`
        against HandConfig().mount.T_flange_from_wrist().
    -->
    <xacro:macro name="epfl_hand_description" params="parent_link robot_name">

        <xacro:property name="marker_size" value="0.03" />

        <!--
            Marker geometry only, so the frame is visible in RViz. Visualizing the hand
            itself is deliberately out of scope. No <collision>, matching the robotiq
            adapter link, so this adds nothing to the collision scene. The <inertial> is
            whatever payload_id_node last measured, and nothing before the first run.
        -->
        <link name="${robot_name}_epfl_wrist_link">
            <xacro:gepetto_payload_inertial />
            <visual>
                <geometry>
                    <box size="${marker_size} ${marker_size} ${marker_size}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="grey" />
            </visual>
        </link>

        <joint name="${robot_name}_epfl_wrist_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${robot_name}_epfl_wrist_link" />
            <origin xyz="-0.009490 -0.010641 0.139688"
                    rpy="1.570796 0.174533 -1.570796" />
        </joint>

        <!--
            Compatibility alias for the unchanged gepetto_ros API. Its nodes still
            resolve <robot_name>_gepetto_wrist_link; new descriptions, planning
            groups, and integrations should use <robot_name>_epfl_wrist_link.
        -->
        <link name="${robot_name}_gepetto_wrist_link" />
        <joint name="${robot_name}_gepetto_wrist_compat_joint" type="fixed">
            <parent link="${robot_name}_epfl_wrist_link" />
            <child link="${robot_name}_gepetto_wrist_link" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

    </xacro:macro>

</robot>
